# Required: base URL for the IBKR Client Portal Gateway (v1 API prefix).
GATEWAY_BASE_URL=https://localhost:5050/v1/api
# Optional: basic auth credentials for the dashboard UI.
USERNAME=
PASSWORD=
# Optional: days of trade history used for base-currency cost of foreign positions (default 3650).
IBKR_TXN_DAYS=
# Telegram settings (optional; only required for telegram.php)
TELEGRAM_TOKEN=
TELEGRAM_CHAT=
